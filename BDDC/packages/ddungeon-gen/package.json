{
  "name": "ddungeon-gen",
  "version": "0.1.0",
  "description": "Deterministic Darkest-Dungeon-style grid dungeon topology generator",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "dungeon",
    "generator",
    "darkest-dungeon",
    "grid",
    "topology",
    "seeded",
    "random"
  ],
  "license": "MIT"
}
